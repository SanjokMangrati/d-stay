NODE_ENV=test
PORT=8080
# Overridden per run by the Testcontainers harness; this value only keeps the
# config schema satisfied when a test boots the app without a container.
DATABASE_URL=postgresql://dstay:dstay@127.0.0.1:5432/dstay_test
LOG_LEVEL=silent
WEB_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=test-secret-not-used-outside-the-integration-suite
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
# Redis and object storage come from docker-compose; the suite boots the real
# AppModule, so the media queue needs a connection to exist.
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=dstay-media
S3_ACCESS_KEY_ID=dstay
S3_SECRET_ACCESS_KEY=dstaydstay
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/dstay-media
