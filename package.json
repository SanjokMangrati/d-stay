{
  "name": "d-stay",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "codegen:check": "turbo run codegen && git diff --exit-code -- apps/api/openapi.json packages/api-client/src/generated"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20.9"
  }
}
