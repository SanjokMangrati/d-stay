{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "openapi": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsconfig.json"],
      "outputs": ["openapi.json"]
    },
    "codegen": {
      "dependsOn": ["api#openapi"],
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "dev": {
      // `packages/*` build into gitignored `dist`, so without this a fresh
      // clone starts `web` before `@d-stay/domain` has any output to import.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
