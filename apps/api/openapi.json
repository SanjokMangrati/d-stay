  "info": {
    "title": "d-stay API",
    "description": "Host, admin and guest surfaces for d-stay homestays.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "status",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      },
      "UserProfileDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "HOST",
              "ADMIN"
            ]
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+91[6-9]\\d{9}$",
            "nullable": true
          },
          "phoneVerified": {
            "type": "boolean"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "locale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "emailVerified",
          "role",
          "phone",
          "phoneVerified",
          "avatarUrl",
          "locale"
        ],
        "additionalProperties": false
      },
      "UpdateUserProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+91[6-9]\\d{9}$",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          }
        }
      },
      "PropertyListDto_Output": {
        "type": "object",
        "properties": {
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": {
                  "type": "string"
                },
                "membershipRole": {
                  "type": "string",
                  "enum": [
                    "OWNER",
                    "MANAGER",
                    "STAFF",
                    null
                  ],
                  "nullable": true
                }
              },
              "required": [
                "id",
                "name",
                "membershipRole"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "properties"
        ],
        "additionalProperties": false
      },
      "PropertySummaryDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "membershipRole": {
            "type": "string",
            "enum": [
              "OWNER",
              "MANAGER",
              "STAFF",
              null
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "membershipRole"
        ],
        "additionalProperties": false
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
