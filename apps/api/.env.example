# Every variable here is validated at boot by src/config/env.schema.ts — the API
# refuses to start if one is missing or malformed. Copy to .env for local dev.

NODE_ENV=development
PORT=8080

# Postgres from docker-compose
DATABASE_URL="postgresql://dstay:dstay@localhost:5432/dstay?schema=public"

# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Origin allowed to call this API with credentials
WEB_APP_URL=http://localhost:3000
