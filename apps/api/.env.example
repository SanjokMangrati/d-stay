# Every variable here is validated at boot by src/config/env.schema.ts — the API
# refuses to start if one is missing or malformed. Copy to .env for local dev.

NODE_ENV=development
PORT=8080

# Postgres from docker-compose. Use 127.0.0.1 rather than localhost: on Windows
# the latter resolves to ::1 first and the Docker port binding rejects it.
DATABASE_URL="postgresql://dstay:dstay@127.0.0.1:5432/dstay?schema=public"

# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Origin the browser loads. Session cookies, OAuth callbacks and email links are
# built from it — browsers reach this API only through the web app's /api proxy.
WEB_APP_URL=http://localhost:3000

# Signs session cookies and verification tokens. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Google OAuth credentials. Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
